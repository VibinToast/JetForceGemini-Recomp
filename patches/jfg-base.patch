-inline uint8_t mem_bu(uint8_t* rdram, gpr addr) {
-    return *reinterpret_cast<uint8_t*>(rdram + (((addr & 0xFFFFFFFFULL) ^ 3) - 0x80000000ULL));
-}
-
-inline void store_b(uint8_t* rdram, gpr addr, int8_t value) {
