+static void handle_toggle_key(const SDL_Event& event) {
+    if (event.type == SDL_KEYDOWN && !event.key.repeat) {
+        const SDL_Scancode code = event.key.keysym.scancode;
+        b_alt_alone = code == SDL_SCANCODE_LALT || code == SDL_SCANCODE_RALT;
+    }
+    else if (event.type == SDL_KEYUP && (event.key.keysym.scancode == SDL_SCANCODE_LALT || event.key.keysym.scancode == SDL_SCANCODE_RALT)) {
+        if (b_alt_alone && b_is_open && b_toolbar_mode) set_toolbar_game_input(!b_toolbar_game_input.load());
+        b_alt_alone = false;
+    }
+    if (event.type != SDL_KEYDOWN || event.key.repeat) return;
+    const SDL_Scancode code = event.key.keysym.scancode;
+    if (code == SDL_Scancode::SDL_SCANCODE_GRAVE || code == SDL_Scancode::SDL_SCANCODE_F9 || code == SDL_Scancode::SDL_SCANCODE_F10) {
+        const bool toolbar = code == SDL_Scancode::SDL_SCANCODE_F10;
+        if (b_is_open && b_toolbar_mode == toolbar) b_is_open = false;
+        else { b_is_open = true; b_toolbar_mode = toolbar; }
+        b_toolbar_game_input = false;
+        b_click_outside = false;
+    }
+}
