From 439a539bafd7c2b95cf3b5d02e4db0bc9caa73cf Mon Sep 17 00:00:00 2001
From: Alexander Ottenhoff <alexander.ottenhoff@gmail.com>
Date: Fri, 30 Oct 2026 21:54:53 +1100
Subject: [PATCH 2/2] Android: keep the texture cache set boundless

Restore update-after-bind/partially-bound/variable-count on the framebuffer
renderer's texture set (the texture cache relies on them; without them Adreno
read stale or unwritten descriptors: corrupted textures and device loss), with
the variable count capped at the Android range of 1024.
---
 src/render/rt64_descriptor_sets.h | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/src/render/rt64_descriptor_sets.h b/src/render/rt64_descriptor_sets.h
index bf08755..57cfe68 100644
--- a/src/render/rt64_descriptor_sets.h
+++ b/src/render/rt64_descriptor_sets.h
@@ -302,16 +302,20 @@ namespace RT64 {
         uint32_t gTMEM;
 
         FramebufferRendererDescriptorTextureSet(RenderDevice *device = nullptr, uint32_t textureCacheSize = 0) {
+#if defined(__ANDROID__)
+            // The variable count can't exceed the declared range (and the shaders' RT64_TEXTURE_CACHE_SIZE).
+            if (textureCacheSize > UpperRange) {
+                fprintf(stderr, "Texture cache wants %u descriptors; Android build is limited to %d.\n", textureCacheSize, UpperRange);
+                textureCacheSize = UpperRange;
+            }
+#endif
             this->textureCacheSize = textureCacheSize;
 
             builder.begin();
             gTextures = builder.addTexture(0, UpperRange);
             gTMEM = gTextures;
-#if defined(__ANDROID__)
-            builder.end();
-#else
+            // Boundless: update-after-bind and partially bound, which the texture cache relies on.
             builder.end(true, textureCacheSize);
-#endif
 
             if (device != nullptr) {
                 create(device);
-- 
