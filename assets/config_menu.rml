<rml>
<head>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="recomp.rcss"/>
	<title>Inventory</title>
	<style>
		body
		{
			width: 100%;
			height: 100%;
		}

		/* Hide the window icon. */
		div#title_bar div#icon
		{
			display: none;
		}
		.flex-grid {
			display: flex;
		}
		.col {
			flex: 1;
			text-align: center;
		}
	</style>
	<link type="text/template" href="config_menu/controls.rml" />
	<link type="text/template" href="config_menu/mods.rml" />
	<!-- JFG PORT: the port's tabs (generated by tools/gen_jfg_config_rml.py) -->
	<link type="text/template" href="config_menu/jfg_profiles.rml" />
	<link type="text/template" href="config_menu/jfg_general.rml" />
	<link type="text/template" href="config_menu/jfg_gameplay.rml" />
	<link type="text/template" href="config_menu/jfg_controls.rml" />
	<link type="text/template" href="config_menu/jfg_graphics.rml" />
	<link type="text/template" href="config_menu/jfg_textures.rml" />
	<style>
		.jfg-selected { border-color: #3cc8ff; background-color: rgba(60, 200, 255, 0.35); color: #e8f3ff; }
		.jfg-note { color: #3cc8ff; }
		/* JFG PORT: group headings in the emblem gold, as in the launcher (the options and selections are "Gemini" cyan). */
		.config-group__title { color: #ffb21a; }
		/* The chosen choice of each option, the open tab and the sliders in "Gemini" cyan, the window edge in the
		   launcher's border blue (recomp.rcss has them white). */
		.config-option__list input.radio:not(:disabled):checked+.config-option__tab-label { border-color: #3cc8ff; color: #3cc8ff; }
		.tab:selected { color: #3cc8ff; }
		.tab:selected .tab__indicator { background-color: #3cc8ff; }
		.config-option__list input.range slidertrack { background-color: rgba(60, 200, 255, 0.3); }
		.config-option__list input.range sliderbar { background-color: #3cc8ff; }
		.config-option__list input.range sliderbar:hover { background-color: #e8f3ff; }
		.centered-page__modal { border-color: #1f3d73; }
		/* The quit and close buttons (top right): navy with a blue edge and cyan icons; quit turns "Jet Force" red. */
		.config__icon-buttons .icon-button { border-color: #1f3d73; background-color: rgba(11, 23, 51, 0.9); }
		.config__icon-buttons .icon-button svg { image-color: #3cc8ff; }
		.config__icon-buttons .icon-button:hover, .config__icon-buttons .icon-button:focus { border-color: #3cc8ff; background-color: rgba(60, 200, 255, 0.25); }
		.config__icon-buttons .icon-button:hover svg, .config__icon-buttons .icon-button:focus svg { image-color: #e8f3ff; }
		#config__quit-game-button svg { image-color: #e8202a; }
		#config__quit-game-button:hover, #config__quit-game-button:focus { border-color: #e8202a; background-color: rgba(232, 32, 42, 0.3); }
		#config__quit-game-button:hover svg, #config__quit-game-button:focus svg { image-color: #e8f3ff; }
		/* JFG PORT: the focused option's description (the port's tabs): the option's name as a heading and larger,
		   brighter text with more space between lines, set off by a cyan bar. */
		.jfg-desc { padding: 32dp 36dp; }
		/* The port's options sit slightly in from their group's heading (the gold titles). */
		.jfg-option { margin-left: 28dp; }
		.jfg-desc__card { display: block; padding: 6dp 0dp 6dp 26dp; border-left: 4dp #3cc8ff; }
		.jfg-desc__title { display: block; margin-bottom: 18dp; font-size: 30dp; line-height: 38dp; letter-spacing: 2dp; font-weight: bold; color: #ffb21a; }
		.jfg-desc p { padding: 0dp; font-size: 25dp; line-height: 39dp; letter-spacing: 0.5dp; color: #e8f3ff; }
		.jfg-desc p b { color: #3cc8ff; }
		/* JFG PORT: the Textures tab's packs as cards (image, name, version and author from the pack's credits.json), and on
		   the right the focused pack's details. */
		.jfg-pack-list { display: block; width: 100%; margin-top: 16dp; }
		.jfg-pack-join { display: block; margin: 12dp 12dp 0dp; font-size: 20dp; line-height: 28dp; color: #ffb21a; }
		.jfg-pack { display: flex; flex-direction: row; align-items: center; width: 100%; box-sizing: border-box; margin: 0dp 0dp 12dp; padding: 12dp;
			text-align: left; nav-up: auto; nav-down: auto; nav-left: auto; nav-right: auto; }
		.jfg-pack__thumb { flex: 0 0 auto; width: 72dp; height: 72dp; margin-right: 22dp; background-color: rgba(3, 8, 22, 0.8); }
		.jfg-pack__text { display: block; flex: 1 1 auto; }
		.jfg-pack__name { display: block; }
		.jfg-pack__meta { display: block; margin-top: 10dp; font-size: 20dp; line-height: 24dp; letter-spacing: 1dp; font-weight: normal; color: #8199bf; }
		.jfg-pack.jfg-selected .jfg-pack__meta { color: #e8f3ff; }
		/* The pack's variant (credits.json, "4K") as a gold bubble after its name. */
		.jfg-pack__variant { display: inline-block; margin-left: 12dp; padding: 3dp 13dp; border-radius: 14dp; background-color: #ffb21a; color: #050b1c;
			font-size: 21dp; line-height: 23dp; letter-spacing: 1dp; vertical-align: middle; }
		.jfg-pack__size { margin-left: 16dp; }
		.jfg-pack__tags { display: flex; flex: 0 0 auto; flex-direction: column; align-items: flex-end; margin-left: 16dp; }
		.jfg-pack__update { display: block; margin-bottom: 8dp; padding: 3dp 10dp; background-color: #ffb21a; color: #050b1c;
			font-size: 16dp; line-height: 18dp; letter-spacing: 1dp; text-transform: uppercase; }
		.jfg-pack__tags .jfg-pack__kind { margin-left: 0dp; }
		.jfg-pack__kind { flex: 0 0 auto; margin-left: 16dp; padding: 4dp 10dp; border-width: 2dp; border-color: #ffb21a; color: #ffb21a;
			font-size: 18dp; line-height: 20dp; letter-spacing: 1dp; text-transform: uppercase; }
		.jfg-pack-detail__image { display: block; width: 160dp; height: 160dp; margin-bottom: 28dp; }
		.jfg-pack-detail__meta { display: block; margin: -6dp 0dp 18dp; font-size: 22dp; line-height: 28dp; color: #3cc8ff; }
		.jfg-pack-detail__site { display: inline-block; margin-top: 24dp; padding: 14dp 18dp; font-size: 20dp; line-height: 22dp; letter-spacing: 1dp; text-transform: none; }
		/* JFG PORT: eight tabs do not fit at the base size: they ran under the tools, launcher, quit and close buttons
		   (absolutely placed at the top right). Slightly smaller tabs, and the tab row keeps clear of the four buttons. */
		#config_tabset tabs { padding-right: 284dp; }
		#config_tabset tab.tab { nav-up: none; padding-left: 16dp; padding-right: 16dp; font-size: 32dp; letter-spacing: 2dp; line-height: 32dp; }
	</style>
</head>
<body class="window">
	<!-- <handle move_target="#document"> -->
		<div id="window" class="rmlui-window" style="display:flex; flex-flow: column; background-color:rgba(0,0,0,0)" onkeydown="config_keydown">
			<div class="centered-page" onclick="close_config_menu_backdrop">
				<div class="centered-page__modal">
					<tabset class="tabs" id="config_tabset">
						<!-- JFG PORT: the port's tabs (see config_tab_to_index), plus Bindings (the recomp's Controls tab) and Mods.
						     The recomp's General, Graphics and Sound options are in the port's tabs. -->
						<!-- The top row wraps round: Left from Profiles goes to the close button, Right from it back here. -->
						<tab class="tab" autofocus id="tab_jfg_profiles" style="nav-left: #config__close-menu-button;">
							<div>Profiles</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_profiles_model">
							<template src="config-menu__jfg_profiles" />
						</panel>
						<tab class="tab" id="tab_jfg_general">
							<div>General</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_general_model">
							<template src="config-menu__jfg_general" />
						</panel>
						<tab class="tab" id="tab_jfg_gameplay">
							<div>Gameplay</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_gameplay_model">
							<template src="config-menu__jfg_gameplay" />
						</panel>
						<tab class="tab" id="tab_jfg_controls">
							<div>Controls</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_controls_model">
							<template src="config-menu__jfg_controls" />
						</panel>
						<tab class="tab" id="tab_controls">
							<div>Bindings</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="controls_model">
							<template src="config-menu__controls" />
						</panel>
						<tab class="tab" id="tab_jfg_graphics">
							<div>Graphics</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_graphics_model">
							<template src="config-menu__jfg_graphics" />
						</panel>
						<tab class="tab" id="tab_jfg_textures">
							<div>Textures</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_textures_model">
							<template src="config-menu__jfg_textures" />
						</panel>
						<tab class="tab" id="tab_mods">
							<div>Mods</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config">
							<template src="config-menu__mods" />
						</panel>
					</tabset>
					<div class="config__icon-buttons">
						<!-- JFG PORT: Tools (F10's tools bar - cheats, level warp, items - for a controller: src/jfg/jfg_ui_tools.cpp) -->
						<button
							class="icon-button"
							onclick="open_jfg_tools"
							id="config__tools-button"
						>
							<svg src="icons/Tools.svg" />
						</button>
						<!-- JFG PORT: Return to Launcher (restarts the game on the launcher: src/ui/ui_config.cpp) -->
						<button
							class="icon-button"
							onclick="open_return_to_launcher_prompt"
							id="config__launcher-button"
						>
							<svg src="icons/Launcher.svg" />
						</button>
						<button
							class="icon-button"
							onclick="open_quit_game_prompt"
							id="config__quit-game-button"
						>
							<svg src="icons/Quit.svg" />
						</button>
						<button
							class="icon-button"
							onclick="close_config_menu"
							id="config__close-menu-button"
							style="nav-right: #tab_jfg_profiles;"
						>
							<svg src="icons/X.svg" />
						</button>
					</div>
				</div>
				<div
					class="centered-page__controls"
					data-model="nav_help_model"
				>
					<label>
						<span>Navigate</span>
						<span class="prompt-font-sm">{{nav_help__navigate}}</span>
					</label>
					<label>
						<span>Accept</span>
						<span class="prompt-font-sm">{{nav_help__accept}}</span>
					</label>
					<label>
						<span>Exit</span>
						<span class="prompt-font-sm">{{nav_help__exit}}</span>
					</label>
					<!-- <label><span style="font-family:promptfont;">&#x21F3;</span> Navigate</label>
					<label><span style="font-family:promptfont;">&#x21A7;</span> Accept</label> -->
				</div>
			</div>
		</div>
	<!-- </handle> -->
	<!-- <handle size_target="#document" style="position: absolute; width: 16dp; height: 16dp; bottom: 0px; right: 0px; cursor: resize;"></handle> -->
</body>
</rml>
