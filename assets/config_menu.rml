<rml>
<head>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="recomp.rcss"/>
	<title>Inventory</title>
	<style>
		body
		{
			width: 100%;
			height: 100%;
		}

		/* Hide the window icon. */
		div#title_bar div#icon
		{
			display: none;
		}
		.flex-grid {
			display: flex;
		}
		.col {
			flex: 1;
			text-align: center;
		}
	</style>
	<link type="text/template" href="config_menu/controls.rml" />
	<link type="text/template" href="config_menu/mods.rml" />
	<!-- JFG PORT: the port's tabs (generated by tools/gen_jfg_config_rml.py) -->
	<link type="text/template" href="config_menu/jfg_profiles.rml" />
	<link type="text/template" href="config_menu/jfg_general.rml" />
	<link type="text/template" href="config_menu/jfg_gameplay.rml" />
	<link type="text/template" href="config_menu/jfg_controls.rml" />
	<link type="text/template" href="config_menu/jfg_graphics.rml" />
	<link type="text/template" href="config_menu/jfg_textures.rml" />
	<style>
		.jfg-selected { border-color: #e9cd35; background-color: rgba(233, 205, 53, 0.35); color: #f2f2f2; }
		.jfg-note { color: #e9cd35; }
		/* JFG PORT: eight tabs do not fit at the base size: they ran under the quit and close buttons (absolutely placed at
		   the top right). Slightly smaller tabs, and the tab row keeps clear of the buttons. */
		#config_tabset tabs { padding-right: 144dp; }
		#config_tabset tab.tab { nav-up: none; padding-left: 16dp; padding-right: 16dp; font-size: 32dp; letter-spacing: 2dp; line-height: 32dp; }
	</style>
</head>
<body class="window">
	<!-- <handle move_target="#document"> -->
		<div id="window" class="rmlui-window" style="display:flex; flex-flow: column; background-color:rgba(0,0,0,0)" onkeydown="config_keydown">
			<div class="centered-page" onclick="close_config_menu_backdrop">
				<div class="centered-page__modal">
					<tabset class="tabs" id="config_tabset">
						<!-- JFG PORT: the port's tabs (see config_tab_to_index), plus Bindings (the recomp's Controls tab) and Mods.
						     The recomp's General, Graphics and Sound options are in the port's tabs. -->
						<tab class="tab" autofocus id="tab_jfg_profiles">
							<div>Profiles</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_profiles_model">
							<template src="config-menu__jfg_profiles" />
						</panel>
						<tab class="tab" id="tab_jfg_general">
							<div>General</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_general_model">
							<template src="config-menu__jfg_general" />
						</panel>
						<tab class="tab" id="tab_jfg_gameplay">
							<div>Gameplay</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_gameplay_model">
							<template src="config-menu__jfg_gameplay" />
						</panel>
						<tab class="tab" id="tab_jfg_controls">
							<div>Controls</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_controls_model">
							<template src="config-menu__jfg_controls" />
						</panel>
						<tab class="tab" id="tab_controls">
							<div>Bindings</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="controls_model">
							<template src="config-menu__controls" />
						</panel>
						<tab class="tab" id="tab_jfg_graphics">
							<div>Graphics</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_graphics_model">
							<template src="config-menu__jfg_graphics" />
						</panel>
						<tab class="tab" id="tab_jfg_textures">
							<div>Textures</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="jfg_textures_model">
							<template src="config-menu__jfg_textures" />
						</panel>
						<tab class="tab" id="tab_mods">
							<div>Mods</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config">
							<template src="config-menu__mods" />
						</panel>
					</tabset>
					<div class="config__icon-buttons">
						<button
							class="icon-button"
							onclick="open_quit_game_prompt"
							id="config__quit-game-button"
						>
							<svg src="icons/Quit.svg" />
						</button>
						<button
							class="icon-button"
							onclick="close_config_menu"
							id="config__close-menu-button"
						>
							<svg src="icons/X.svg" />
						</button>
					</div>
				</div>
				<div
					class="centered-page__controls"
					data-model="nav_help_model"
				>
					<label>
						<span>Navigate</span>
						<span class="prompt-font-sm">{{nav_help__navigate}}</span>
					</label>
					<label>
						<span>Accept</span>
						<span class="prompt-font-sm">{{nav_help__accept}}</span>
					</label>
					<label>
						<span>Exit</span>
						<span class="prompt-font-sm">{{nav_help__exit}}</span>
					</label>
					<!-- <label><span style="font-family:promptfont;">&#x21F3;</span> Navigate</label>
					<label><span style="font-family:promptfont;">&#x21A7;</span> Accept</label> -->
				</div>
			</div>
		</div>
	<!-- </handle> -->
	<!-- <handle size_target="#document" style="position: absolute; width: 16dp; height: 16dp; bottom: 0px; right: 0px; cursor: resize;"></handle> -->
</body>
</rml>
