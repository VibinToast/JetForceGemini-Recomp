<template name="config-menu__jfg_textures">
    <head>
    </head>
    <body>
        <form class="config__form">
            <div class="config__hz-wrapper">
                <!-- Options (generated by tools/gen_jfg_config_rml.py) -->
                <div class="config__wrapper" data-event-mouseout="set_cur_config_index(-1)" style="overflow-y: auto; height: 100%;">
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Texture Pack</label></div>
                    <div class="config-option jfg-option" style="flex: 0 0 auto;">
                        <label class="config-option__title jfg-pack-status">{{pack_status}}<span class="jfg-pack__variant" data-if="pack_status_variant != ''">{{pack_status_variant}}</span>{{pack_status_count}}</label>
                        <div class="jfg-note jfg-pack-join" data-if="pack_join_text != ''">{{pack_join_text}}</div>
                        <div class="jfg-pack-list">
                            <button class="button jfg-pack" data-for="p : packs" data-attr-id="'jfg_pack_' + it_index" data-style-nav-left="it_index == 0 ? '#tab_jfg_textures' : 'auto'" data-style-nav-up="it_index == 0 ? '#tab_jfg_textures' : 'auto'" data-event-click="set_pack(p.folder)" data-event-focus="view_pack(it_index)" data-event-mouseover="view_pack(it_index)" data-class-jfg-selected="p.selected">
                                <div class="jfg-pack__thumb" data-style-decorator="p.image != '' ? 'image(' + p.image + ' contain)' : 'none'"></div>
                                <div class="jfg-pack__text">
                                    <div class="jfg-pack__name">{{p.label}}<span class="jfg-pack__variant" data-if="p.variant != ''">{{p.variant}}</span></div>
                                    <div class="jfg-pack__meta">{{p.version}} {{p.author}}<span class="jfg-pack__size" data-if="p.size != ''">{{p.size}}</span></div>
                                </div>
                                <div class="jfg-pack__tags">
                                    <div class="jfg-pack__update" data-if="p.update">Update available</div>
                                    <div class="jfg-pack__kind" data-if="p.kind != ''">{{p.kind}}</div>
                                </div>
                            </button>
                        </div>
                        <div style="display: block; width: 100%;">
                            <button class="button" style="display: inline-block; margin: 8dp; nav-up: auto; nav-down: auto; nav-left: #tab_jfg_textures;" data-event-click="reload_pack()">Reload Pack</button>
                            <span class="jfg-desktop-only"><button class="button" style="display: inline-block; margin: 8dp; nav-up: auto; nav-down: auto; nav-left: auto;" data-event-click="open_pack_folder()">Open Texture Packs Folder</button></span>
                        </div>
                        <div class="jfg-note" style="display: block; margin: 8dp 12dp 0dp; font-size: 18dp; line-height: 26dp;">Packs are the folders (or .rtz files) in the texture_packs folder next to the game. F6 switches packs while playing. Reload after adding or changing files. <span>{{dump_status}}</span></div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Texture Dumping</label></div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(0)">
                        <label class="config-option__title">Dump Textures</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(0)" name="jfg_texture_dump" data-checked="texture_dump" value="1" id="jfg_texture_dump_on" style="nav-down: #jfg_dump_by_level_on;"/>
                            <label class="config-option__tab-label" for="jfg_texture_dump_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(0)" name="jfg_texture_dump" data-checked="texture_dump" value="0" id="jfg_texture_dump_off" style="nav-down: #jfg_dump_by_level_off;"/>
                            <label class="config-option__tab-label" for="jfg_texture_dump_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">One Folder per Level</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_dump_by_level" data-checked="dump_by_level" value="1" id="jfg_dump_by_level_on" style="nav-up: #jfg_texture_dump_on; nav-down: none;"/>
                            <label class="config-option__tab-label" for="jfg_dump_by_level_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_dump_by_level" data-checked="dump_by_level" value="0" id="jfg_dump_by_level_off" style="nav-up: #jfg_texture_dump_off; nav-down: none;"/>
                            <label class="config-option__tab-label" for="jfg_dump_by_level_off">Off</label>
                        </div>
                    </div>

                </div>
                <!-- Descriptions -->
                <div class="config__wrapper jfg-desc">
                    <div data-if="cur_config_index == 0"><div class="jfg-desc__card"><div class="jfg-desc__title">Dump Textures</div><p>Saves every texture the game draws, the first time it appears, to the texture_dump folder next to the game, as &lt;hash&gt;.png. Off again at the next start. Upscale the files without renaming them and put them in a pack folder (texture_packs\&lt;name&gt;).</p></div></div>
                    <div data-if="cur_config_index == 1"><div class="jfg-desc__card"><div class="jfg-desc__title">One Folder per Level</div><p>Dumps into texture_dump\&lt;level number&gt; &lt;level name&gt; instead.</p></div></div>
                    <div data-if="cur_config_index == -1"><div data-for="p : packs"><div data-if="it_index == pack_view">
                        <div class="jfg-pack-detail__image" data-if="p.image != ''" data-style-decorator="p.image != '' ? 'image(' + p.image + ' contain)' : 'none'"></div>
                        <div class="jfg-desc__card">
                            <div class="jfg-desc__title">{{p.label}}<span class="jfg-pack__variant" data-if="p.variant != ''">{{p.variant}}</span></div>
                            <div class="jfg-pack-detail__meta" data-if="p.version != '' || p.author != '' || p.size != ''">{{p.version}} {{p.author}}<span class="jfg-pack__size" data-if="p.size != ''">{{p.size}}</span></div>
                            <p data-if="p.description != ''">{{p.description}}</p>
                            <p data-if="p.no_details">This pack has no credits.json with its details.</p>
                            <button class="button jfg-pack-detail__site" data-if="p.website != ''" data-event-click="open_pack_website()">{{p.website}}</button>
                        </div>
                    </div></div></div>
                </div>
            </div>
        </form>
    </body>
</template>
