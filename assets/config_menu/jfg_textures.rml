<template name="config-menu__jfg_textures">
    <head>
    </head>
    <body>
        <form class="config__form">
            <div class="config__hz-wrapper">
                <!-- Options (generated by tools/gen_jfg_config_rml.py) -->
                <div class="config__wrapper" data-event-mouseout="set_cur_config_index(-1)" style="overflow-y: auto; height: 100%;">
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Texture Pack</label></div>
                    <div class="config-option" style="flex: 0 0 auto;">
                        <label class="config-option__title">{{pack_status}}</label>
                        <div style="display: block; width: 100%;">
                            <button class="button" style="display: inline-block; margin: 8dp; nav-up: auto; nav-down: auto; nav-left: auto; nav-right: auto;" data-for="p : packs" data-attr-id="'jfg_pack_' + it_index" data-style-nav-left="it_index == 0 ? '#tab_jfg_textures' : 'auto'" data-style-nav-up="it_index == 0 ? '#tab_jfg_textures' : 'auto'" data-event-click="set_pack(p.folder)" data-class-jfg-selected="p.selected">{{p.label}}</button>
                        </div>
                        <div style="display: block; width: 100%;">
                            <button class="button" style="display: inline-block; margin: 8dp; nav-up: auto; nav-down: auto; nav-left: #tab_jfg_textures;" data-event-click="reload_pack()">Reload Pack</button>
                        </div>
                        <div class="jfg-note" style="display: block; margin: 8dp 12dp 0dp; font-size: 18dp; line-height: 26dp;">Packs are the folders in bin\texture_packs. F6 switches packs while playing. Reload after adding or changing files. {{dump_status}}</div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Texture Dumping</label></div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(0)">
                        <label class="config-option__title">Dump Textures</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(0)" name="jfg_texture_dump" data-checked="texture_dump" value="1" id="jfg_texture_dump_on" style="nav-down: #jfg_dump_by_level_on;"/>
                            <label class="config-option__tab-label" for="jfg_texture_dump_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(0)" name="jfg_texture_dump" data-checked="texture_dump" value="0" id="jfg_texture_dump_off" style="nav-down: #jfg_dump_by_level_off;"/>
                            <label class="config-option__tab-label" for="jfg_texture_dump_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">One Folder per Level</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_dump_by_level" data-checked="dump_by_level" value="1" id="jfg_dump_by_level_on" style="nav-up: #jfg_texture_dump_on; nav-down: none;"/>
                            <label class="config-option__tab-label" for="jfg_dump_by_level_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_dump_by_level" data-checked="dump_by_level" value="0" id="jfg_dump_by_level_off" style="nav-up: #jfg_texture_dump_off; nav-down: none;"/>
                            <label class="config-option__tab-label" for="jfg_dump_by_level_off">Off</label>
                        </div>
                    </div>

                </div>
                <!-- Descriptions -->
                <div class="config__wrapper">
                    <p data-if="cur_config_index == 0">Saves every texture the game draws, the first time it appears, to bin\texture_dump as &lt;hash&gt;.png. Off again at the next start. Upscale the files without renaming them and put them in a pack folder (bin\texture_packs\&lt;name&gt;).</p>
                    <p data-if="cur_config_index == 1">Dumps into bin\texture_dump\&lt;level number&gt; &lt;level name&gt; instead.</p>
                </div>
            </div>
        </form>
    </body>
</template>
