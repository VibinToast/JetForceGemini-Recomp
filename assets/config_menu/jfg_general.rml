<template name="config-menu__jfg_general">
    <head>
    </head>
    <body>
        <form class="config__form">
            <div class="config__hz-wrapper">
                <!-- Options (generated by tools/gen_jfg_config_rml.py) -->
                <div class="config__wrapper" data-event-mouseout="set_cur_config_index(-1)" style="overflow-y: auto; height: 100%;">

                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Sound</label></div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(0)">
                        <label class="config-option__title">Master Volume</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{main_volume}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(0)" id="jfg_main_volume_input" type="range" min="0" max="100" style="flex: 1; margin: 0dp; nav-up: #tab_jfg_general; nav-down: #jfg_pause_in_menu_on;" data-value="main_volume"/>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Menu &amp; Cutscenes</label></div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">Pause in Settings Menu</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_pause_in_menu" data-checked="pause_in_menu" value="1" id="jfg_pause_in_menu_on" style="nav-up: #jfg_main_volume_input; nav-down: #jfg_start_skips_cutscenes_on;"/>
                            <label class="config-option__tab-label" for="jfg_pause_in_menu_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_pause_in_menu" data-checked="pause_in_menu" value="0" id="jfg_pause_in_menu_off" style="nav-up: #jfg_main_volume_input; nav-down: #jfg_start_skips_cutscenes_off;"/>
                            <label class="config-option__tab-label" for="jfg_pause_in_menu_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(2)">
                        <label class="config-option__title">START Skips Cutscenes</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(2)" name="jfg_start_skips_cutscenes" data-checked="start_skips_cutscenes" value="1" id="jfg_start_skips_cutscenes_on" style="nav-up: #jfg_pause_in_menu_on; nav-down: #jfg_show_fps_on;"/>
                            <label class="config-option__tab-label" for="jfg_start_skips_cutscenes_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(2)" name="jfg_start_skips_cutscenes" data-checked="start_skips_cutscenes" value="0" id="jfg_start_skips_cutscenes_off" style="nav-up: #jfg_pause_in_menu_off; nav-down: #jfg_show_fps_off;"/>
                            <label class="config-option__tab-label" for="jfg_start_skips_cutscenes_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">On Screen</label></div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(3)">
                        <label class="config-option__title">Show FPS</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(3)" name="jfg_show_fps" data-checked="show_fps" value="1" id="jfg_show_fps_on" style="nav-up: #jfg_start_skips_cutscenes_on; nav-down: #jfg_show_level_on;"/>
                            <label class="config-option__tab-label" for="jfg_show_fps_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(3)" name="jfg_show_fps" data-checked="show_fps" value="0" id="jfg_show_fps_off" style="nav-up: #jfg_start_skips_cutscenes_off; nav-down: #jfg_show_level_off;"/>
                            <label class="config-option__tab-label" for="jfg_show_fps_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(4)">
                        <label class="config-option__title">Show Level</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_show_level" data-checked="show_level" value="1" id="jfg_show_level_on" style="nav-up: #jfg_show_fps_on; nav-down: #jfg_show_pack_on;"/>
                            <label class="config-option__tab-label" for="jfg_show_level_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_show_level" data-checked="show_level" value="0" id="jfg_show_level_off" style="nav-up: #jfg_show_fps_off; nav-down: #jfg_show_pack_off;"/>
                            <label class="config-option__tab-label" for="jfg_show_level_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(5)">
                        <label class="config-option__title">Show Texture Pack</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(5)" name="jfg_show_pack" data-checked="show_pack" value="1" id="jfg_show_pack_on" style="nav-up: #jfg_show_level_on; nav-down: #jfg_save_notification_on;"/>
                            <label class="config-option__tab-label" for="jfg_show_pack_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(5)" name="jfg_show_pack" data-checked="show_pack" value="0" id="jfg_show_pack_off" style="nav-up: #jfg_show_level_off; nav-down: #jfg_save_notification_off;"/>
                            <label class="config-option__tab-label" for="jfg_show_pack_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(6)">
                        <label class="config-option__title">Show Save Notification</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(6)" name="jfg_save_notification" data-checked="save_notification" value="1" id="jfg_save_notification_on" style="nav-up: #jfg_show_pack_on; nav-down: #jfg_fly_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_save_notification_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(6)" name="jfg_save_notification" data-checked="save_notification" value="0" id="jfg_save_notification_off" style="nav-up: #jfg_show_pack_off; nav-down: #jfg_fly_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_save_notification_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Fly Camera (F7)</label></div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(7)">
                        <label class="config-option__title">Fly Speed</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{fly_speed}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(7)" id="jfg_fly_speed_input" type="range" min="10" max="1000" style="flex: 1; margin: 0dp; nav-up: #jfg_save_notification_on; nav-down: #jfg_fly_freeze_on;" data-value="fly_speed"/>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(8)">
                        <label class="config-option__title">Freeze While Flying</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(8)" name="jfg_fly_freeze" data-checked="fly_freeze" value="1" id="jfg_fly_freeze_on" style="nav-up: #jfg_fly_speed_input; nav-down: #jfg_fly_hide_hud_on;"/>
                            <label class="config-option__tab-label" for="jfg_fly_freeze_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(8)" name="jfg_fly_freeze" data-checked="fly_freeze" value="0" id="jfg_fly_freeze_off" style="nav-up: #jfg_fly_speed_input; nav-down: #jfg_fly_hide_hud_off;"/>
                            <label class="config-option__tab-label" for="jfg_fly_freeze_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(9)">
                        <label class="config-option__title">Hide HUD While Flying</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(9)" name="jfg_fly_hide_hud" data-checked="fly_hide_hud" value="1" id="jfg_fly_hide_hud_on" style="nav-up: #jfg_fly_freeze_on; nav-down: none;"/>
                            <label class="config-option__tab-label" for="jfg_fly_hide_hud_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(9)" name="jfg_fly_hide_hud" data-checked="fly_hide_hud" value="0" id="jfg_fly_hide_hud_off" style="nav-up: #jfg_fly_freeze_off; nav-down: none;"/>
                            <label class="config-option__tab-label" for="jfg_fly_hide_hud_off">Off</label>
                        </div>
                    </div>
                    <div class="jfg-note" style="display: block; margin: 32dp 12dp 16dp; font-size: 18dp; line-height: 26dp;">F10: the tools bar (cheats, level warp, items, weapons, texture packs). F9 or ` (backquote): the all-in-one debug window.</div>
                </div>
                <!-- Descriptions -->
                <div class="config__wrapper">
                    <p data-if="cur_config_index == 0">The volume of all of the game's sound.</p>
                    <p data-if="cur_config_index == 1">The game stands still while the settings menu (Select / Esc) is open during play, as on the pause screen. Cutscenes keep playing.</p>
                    <p data-if="cur_config_index == 2">START skips cutscenes, the logo screens at start-up and the story intro after creating a file. A skipped cutscene still runs to its end at full speed, so everything it does (flags, items, the next level) still happens.</p>
                    <p data-if="cur_config_index == 3">The game's frame rate in the top right corner.</p>
                    <p data-if="cur_config_index == 4">The level number and name in the top right corner.</p>
                    <p data-if="cur_config_index == 5">The texture pack in use in the top right corner.</p>
                    <p data-if="cur_config_index == 6">"Game saved" shows briefly in the bottom right corner after an auto save.</p>
                    <p data-if="cur_config_index == 7">F7 (or F10 > Tools) flies a free camera for screenshots: WASD / left stick move where it looks, mouse / right stick look, Space / A up, Ctrl / B down, holding fire flies faster. F7 again ends it.</p>
                    <p data-if="cur_config_index == 8">The game stands still while the fly camera is on (enemies, effects and the level stop as when paused).</p>
                    <p data-if="cur_config_index == 9">The health meter and the rest of the HUD are hidden while the fly camera is on.</p>
                </div>
            </div>
        </form>
    </body>
</template>
