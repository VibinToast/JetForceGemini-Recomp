<template name="config-menu__jfg_gameplay">
    <head>
    </head>
    <body>
        <form class="config__form">
            <div class="config__hz-wrapper">
                <!-- Options (generated by tools/gen_jfg_config_rml.py) -->
                <div class="config__wrapper" data-event-mouseout="set_cur_config_index(-1)" style="overflow-y: auto; height: 100%;">

                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">General</label></div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(0)">
                        <label class="config-option__title">No Blood</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(0)" name="jfg_no_blood" data-checked="no_blood" value="1" id="jfg_no_blood_on" style="nav-up: #tab_jfg_gameplay; nav-down: #jfg_start_skips_cutscenes_on;"/>
                            <label class="config-option__tab-label" for="jfg_no_blood_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(0)" name="jfg_no_blood" data-checked="no_blood" value="0" id="jfg_no_blood_off" style="nav-up: #tab_jfg_gameplay; nav-down: #jfg_start_skips_cutscenes_off;"/>
                            <label class="config-option__tab-label" for="jfg_no_blood_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">START Skips Cutscenes</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_start_skips_cutscenes" data-checked="start_skips_cutscenes" value="1" id="jfg_start_skips_cutscenes_on" style="nav-up: #jfg_no_blood_on; nav-down: #jfg_auto_save_on;"/>
                            <label class="config-option__tab-label" for="jfg_start_skips_cutscenes_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_start_skips_cutscenes" data-checked="start_skips_cutscenes" value="0" id="jfg_start_skips_cutscenes_off" style="nav-up: #jfg_no_blood_off; nav-down: #jfg_auto_save_off;"/>
                            <label class="config-option__tab-label" for="jfg_start_skips_cutscenes_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(2)">
                        <label class="config-option__title">Auto Save</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(2)" name="jfg_auto_save" data-checked="auto_save" value="1" id="jfg_auto_save_on" style="nav-up: #jfg_start_skips_cutscenes_on; nav-down: #jfg_auto_save_minutes_input;"/>
                            <label class="config-option__tab-label" for="jfg_auto_save_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(2)" name="jfg_auto_save" data-checked="auto_save" value="0" id="jfg_auto_save_off" style="nav-up: #jfg_start_skips_cutscenes_off; nav-down: #jfg_auto_save_minutes_input;"/>
                            <label class="config-option__tab-label" for="jfg_auto_save_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(3)">
                        <label class="config-option__title">Auto Save Interval</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{auto_save_minutes}} min</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(3)" id="jfg_auto_save_minutes_input" type="range" min="0" max="30" style="flex: 1; margin: 0dp; nav-up: #jfg_auto_save_on; nav-down: #jfg_save_notification_on;" data-value="auto_save_minutes"/>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(4)">
                        <label class="config-option__title">Show Save Notification</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_save_notification" data-checked="save_notification" value="1" id="jfg_save_notification_on" style="nav-up: #jfg_auto_save_minutes_input; nav-down: #jfg_keep_area_progress_on;"/>
                            <label class="config-option__tab-label" for="jfg_save_notification_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_save_notification" data-checked="save_notification" value="0" id="jfg_save_notification_off" style="nav-up: #jfg_auto_save_minutes_input; nav-down: #jfg_keep_area_progress_off;"/>
                            <label class="config-option__tab-label" for="jfg_save_notification_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(5)">
                        <label class="config-option__title">Keep Area Progress</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(5)" name="jfg_keep_area_progress" data-checked="keep_area_progress" value="1" id="jfg_keep_area_progress_on" style="nav-up: #jfg_save_notification_on; nav-down: #jfg_permanent_tribals_on;"/>
                            <label class="config-option__tab-label" for="jfg_keep_area_progress_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(5)" name="jfg_keep_area_progress" data-checked="keep_area_progress" value="0" id="jfg_keep_area_progress_off" style="nav-up: #jfg_save_notification_off; nav-down: #jfg_permanent_tribals_off;"/>
                            <label class="config-option__tab-label" for="jfg_keep_area_progress_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(6)">
                        <label class="config-option__title">Permanent Tribal Saves</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(6)" name="jfg_permanent_tribals" data-checked="permanent_tribals" value="1" id="jfg_permanent_tribals_on" style="nav-up: #jfg_keep_area_progress_on; nav-down: #jfg_move_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_permanent_tribals_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(6)" name="jfg_permanent_tribals" data-checked="permanent_tribals" value="0" id="jfg_permanent_tribals_off" style="nav-up: #jfg_keep_area_progress_off; nav-down: #jfg_move_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_permanent_tribals_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Movement &amp; Aiming (any control layout)</label></div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(7)">
                        <label class="config-option__title">Movement Speed</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{move_speed}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(7)" id="jfg_move_speed_input" type="range" min="25" max="400" style="flex: 1; margin: 0dp; nav-up: #jfg_permanent_tribals_on; nav-down: #jfg_sprint_on;" data-value="move_speed"/>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(8)">
                        <label class="config-option__title">Sprint</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(8)" name="jfg_sprint" data-checked="sprint" value="1" id="jfg_sprint_on" style="nav-up: #jfg_move_speed_input; nav-down: #jfg_sprint_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_sprint_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(8)" name="jfg_sprint" data-checked="sprint" value="0" id="jfg_sprint_off" style="nav-up: #jfg_move_speed_input; nav-down: #jfg_sprint_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_sprint_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(9)">
                        <label class="config-option__title">Sprint Speed</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{sprint_speed}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(9)" id="jfg_sprint_speed_input" type="range" min="100" max="300" style="flex: 1; margin: 0dp; nav-up: #jfg_sprint_on; nav-down: #jfg_aim_shoulder_on;" data-value="sprint_speed"/>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(10)">
                        <label class="config-option__title">Over-the-Shoulder Aiming</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(10)" name="jfg_aim_shoulder" data-checked="aim_shoulder" value="1" id="jfg_aim_shoulder_on" style="nav-up: #jfg_sprint_speed_input; nav-down: #jfg_aim_centered_on;"/>
                            <label class="config-option__tab-label" for="jfg_aim_shoulder_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(10)" name="jfg_aim_shoulder" data-checked="aim_shoulder" value="0" id="jfg_aim_shoulder_off" style="nav-up: #jfg_sprint_speed_input; nav-down: #jfg_aim_centered_off;"/>
                            <label class="config-option__tab-label" for="jfg_aim_shoulder_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(11)">
                        <label class="config-option__title">Keep the Reticle Centered</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(11)" name="jfg_aim_centered" data-checked="aim_centered" value="1" id="jfg_aim_centered_on" style="nav-up: #jfg_aim_shoulder_on; nav-down: #jfg_aim_jump_on;"/>
                            <label class="config-option__tab-label" for="jfg_aim_centered_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(11)" name="jfg_aim_centered" data-checked="aim_centered" value="0" id="jfg_aim_centered_off" style="nav-up: #jfg_aim_shoulder_off; nav-down: #jfg_aim_jump_off;"/>
                            <label class="config-option__tab-label" for="jfg_aim_centered_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(12)">
                        <label class="config-option__title">Jump While Aiming</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(12)" name="jfg_aim_jump" data-checked="aim_jump" value="1" id="jfg_aim_jump_on" style="nav-up: #jfg_aim_centered_on; nav-down: #jfg_aim_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_aim_jump_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(12)" name="jfg_aim_jump" data-checked="aim_jump" value="0" id="jfg_aim_jump_off" style="nav-up: #jfg_aim_centered_off; nav-down: #jfg_aim_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_aim_jump_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(13)">
                        <label class="config-option__title">Aim Speed</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{aim_speed}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(13)" id="jfg_aim_speed_input" type="range" min="10" max="300" style="flex: 1; margin: 0dp; nav-up: #jfg_aim_jump_on; nav-down: #jfg_sniper_fixed_zoom_on;" data-value="aim_speed"/>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(14)">
                        <label class="config-option__title">Sniper Fixed Zoom</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(14)" name="jfg_sniper_fixed_zoom" data-checked="sniper_fixed_zoom" value="1" id="jfg_sniper_fixed_zoom_on" style="nav-up: #jfg_aim_speed_input; nav-down: #jfg_sniper_zoom_input;"/>
                            <label class="config-option__tab-label" for="jfg_sniper_fixed_zoom_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(14)" name="jfg_sniper_fixed_zoom" data-checked="sniper_fixed_zoom" value="0" id="jfg_sniper_fixed_zoom_off" style="nav-up: #jfg_aim_speed_input; nav-down: #jfg_sniper_zoom_input;"/>
                            <label class="config-option__tab-label" for="jfg_sniper_fixed_zoom_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(15)">
                        <label class="config-option__title">Sniper Zoom</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{sniper_zoom}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(15)" id="jfg_sniper_zoom_input" type="range" min="100" max="500" style="flex: 1; margin: 0dp; nav-up: #jfg_sniper_fixed_zoom_on; nav-down: #jfg_damage_taken_input;" data-value="sniper_zoom"/>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Player</label></div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(16)">
                        <label class="config-option__title">Damage Taken</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{damage_taken}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(16)" id="jfg_damage_taken_input" type="range" min="0" max="400" style="flex: 1; margin: 0dp; nav-up: #jfg_sniper_zoom_input; nav-down: #jfg_unlimited_continues_on;" data-value="damage_taken"/>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(17)">
                        <label class="config-option__title">Unlimited Continues</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(17)" name="jfg_unlimited_continues" data-checked="unlimited_continues" value="1" id="jfg_unlimited_continues_on" style="nav-up: #jfg_damage_taken_input; nav-down: #jfg_refuel_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_unlimited_continues_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(17)" name="jfg_unlimited_continues" data-checked="unlimited_continues" value="0" id="jfg_unlimited_continues_off" style="nav-up: #jfg_damage_taken_input; nav-down: #jfg_refuel_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_unlimited_continues_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(18)">
                        <label class="config-option__title">Jetpack Refuel Speed</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{refuel_speed}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(18)" id="jfg_refuel_speed_input" type="range" min="25" max="1000" style="flex: 1; margin: 0dp; nav-up: #jfg_unlimited_continues_on; nav-down: #jfg_dive_speed_input;" data-value="refuel_speed"/>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(19)">
                        <label class="config-option__title">Vela&#x27;s Dive Speed</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{dive_speed}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(19)" id="jfg_dive_speed_input" type="range" min="50" max="400" style="flex: 1; margin: 0dp; nav-up: #jfg_refuel_speed_input; nav-down: #jfg_dual_stick_on;" data-value="dive_speed"/>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Dual Stick</label></div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(20)">
                        <label class="config-option__title">Dual-Stick Controls</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(20)" name="jfg_dual_stick" data-checked="dual_stick" value="1" id="jfg_dual_stick_on" style="nav-up: #jfg_dive_speed_input; nav-down: #jfg_dual_layout_on;"/>
                            <label class="config-option__tab-label" for="jfg_dual_stick_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(20)" name="jfg_dual_stick" data-checked="dual_stick" value="0" id="jfg_dual_stick_off" style="nav-up: #jfg_dive_speed_input; nav-down: #jfg_dual_layout_off;"/>
                            <label class="config-option__tab-label" for="jfg_dual_stick_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(21)">
                        <label class="config-option__title">Built-in Button Layout</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(21)" name="jfg_dual_layout" data-checked="dual_layout" value="1" id="jfg_dual_layout_on" style="nav-up: #jfg_dual_stick_on; nav-down: #jfg_swap_triggers_on;"/>
                            <label class="config-option__tab-label" for="jfg_dual_layout_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(21)" name="jfg_dual_layout" data-checked="dual_layout" value="0" id="jfg_dual_layout_off" style="nav-up: #jfg_dual_stick_off; nav-down: #jfg_swap_triggers_off;"/>
                            <label class="config-option__tab-label" for="jfg_dual_layout_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(22)">
                        <label class="config-option__title">Swap Triggers</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(22)" name="jfg_swap_triggers" data-checked="swap_triggers" value="1" id="jfg_swap_triggers_on" style="nav-up: #jfg_dual_layout_on; nav-down: #jfg_invert_aim_y_on;"/>
                            <label class="config-option__tab-label" for="jfg_swap_triggers_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(22)" name="jfg_swap_triggers" data-checked="swap_triggers" value="0" id="jfg_swap_triggers_off" style="nav-up: #jfg_dual_layout_off; nav-down: #jfg_invert_aim_y_off;"/>
                            <label class="config-option__tab-label" for="jfg_swap_triggers_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(23)">
                        <label class="config-option__title">Invert Aim Up/Down</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(23)" name="jfg_invert_aim_y" data-checked="invert_aim_y" value="1" id="jfg_invert_aim_y_on" style="nav-up: #jfg_swap_triggers_on; nav-down: #jfg_invert_camera_y_on;"/>
                            <label class="config-option__tab-label" for="jfg_invert_aim_y_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(23)" name="jfg_invert_aim_y" data-checked="invert_aim_y" value="0" id="jfg_invert_aim_y_off" style="nav-up: #jfg_swap_triggers_off; nav-down: #jfg_invert_camera_y_off;"/>
                            <label class="config-option__tab-label" for="jfg_invert_aim_y_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" data-event-mouseover="set_cur_config_index(24)">
                        <label class="config-option__title">Invert Camera Up/Down</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(24)" name="jfg_invert_camera_y" data-checked="invert_camera_y" value="1" id="jfg_invert_camera_y_on" style="nav-up: #jfg_invert_aim_y_on; nav-down: #jfg_aim_from_character_on;"/>
                            <label class="config-option__tab-label" for="jfg_invert_camera_y_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(24)" name="jfg_invert_camera_y" data-checked="invert_camera_y" value="0" id="jfg_invert_camera_y_off" style="nav-up: #jfg_invert_aim_y_off; nav-down: #jfg_aim_from_character_off;"/>
                            <label class="config-option__tab-label" for="jfg_invert_camera_y_off">Off</label>
