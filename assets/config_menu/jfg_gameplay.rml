                            <label class="config-option__tab-label" for="jfg_aim_from_character_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(25)" name="jfg_aim_from_character" data-checked="aim_from_character" value="0" id="jfg_aim_from_character_off" style="nav-up: #jfg_invert_camera_y_off; nav-down: #jfg_camera_speed_h_input;"/>
                            <label class="config-option__tab-label" for="jfg_aim_from_character_off">Off</label>
