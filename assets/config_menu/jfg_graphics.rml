                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(24)" id="jfg_vignette_size_input" type="range" min="0" max="90" style="flex: 1; margin: 0dp; nav-up: #jfg_vignette_strength_input; nav-down: #jfg_level_fog_distance_input;" data-value="vignette_size"/>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Fog</label></div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(25)">
                        <label class="config-option__title">Level Fog Distance</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{level_fog_distance}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(25)" id="jfg_level_fog_distance_input" type="range" min="50" max="400" style="flex: 1; margin: 0dp; nav-up: #jfg_vignette_size_input; nav-down: #jfg_no_level_fog_on;" data-value="level_fog_distance"/>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(26)">
                        <label class="config-option__title">No Level Fog</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(26)" name="jfg_no_level_fog" data-checked="no_level_fog" value="1" id="jfg_no_level_fog_on" style="nav-up: #jfg_level_fog_distance_input; nav-down: #jfg_show_advanced_on;"/>
                            <label class="config-option__tab-label" for="jfg_no_level_fog_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(26)" name="jfg_no_level_fog" data-checked="no_level_fog" value="0" id="jfg_no_level_fog_off" style="nav-up: #jfg_level_fog_distance_input; nav-down: #jfg_show_advanced_off;"/>
                            <label class="config-option__tab-label" for="jfg_no_level_fog_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Advanced Options</label></div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(27)">
                        <label class="config-option__title">Show Advanced Options</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(27)" name="jfg_show_advanced" data-checked="show_advanced" value="1" id="jfg_show_advanced_on" style="nav-up: #jfg_no_level_fog_on; " data-style-nav-down="advanced_hidden ? 'none' : '#jfg_frame_rate_0'"/>
                            <label class="config-option__tab-label" for="jfg_show_advanced_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(27)" name="jfg_show_advanced" data-checked="show_advanced" value="0" id="jfg_show_advanced_off" style="nav-up: #jfg_no_level_fog_off; " data-style-nav-down="advanced_hidden ? 'none' : '#jfg_frame_rate_1'"/>
                            <label class="config-option__tab-label" for="jfg_show_advanced_off">Off</label>
                        </div>
                    </div>
                    <div data-if="!advanced_hidden"><div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Experimental</label></div></div>
                    <div data-if="!advanced_hidden">
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(28)">
                        <label class="config-option__title">Game Frame Rate</label>
                        <div class="config-option__list">
