<template name="config-menu__jfg_graphics">
    <head>
    </head>
    <body>
        <form class="config__form">
            <div class="config__hz-wrapper">
                <!-- Options (generated by tools/gen_jfg_config_rml.py) -->
                <div class="config__wrapper" data-event-mouseout="set_cur_config_index(-1)" style="overflow-y: auto; height: 100%;">

                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Window</label></div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(0)">
                        <label class="config-option__title">Window Mode</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(0)" name="jfg_wm_option" data-checked="wm_option" value="0" id="jfg_wm_option_0" style="nav-up: #tab_jfg_graphics; nav-down: #jfg_res_option_0;"/>
                            <label class="config-option__tab-label" for="jfg_wm_option_0">Windowed</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(0)" name="jfg_wm_option" data-checked="wm_option" value="1" id="jfg_wm_option_1" style="nav-up: #tab_jfg_graphics; nav-down: #jfg_res_option_1;"/>
                            <label class="config-option__tab-label" for="jfg_wm_option_1">Fullscreen</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">Resolution</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_res_option" data-checked="res_option" value="0" id="jfg_res_option_0" style="nav-up: #jfg_wm_option_0; nav-down: #jfg_ds_option_1;"/>
                            <label class="config-option__tab-label" for="jfg_res_option_0">Original</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_res_option" data-checked="res_option" value="1" id="jfg_res_option_1" style="nav-up: #jfg_wm_option_1; nav-down: #jfg_ds_option_2;"/>
                            <label class="config-option__tab-label" for="jfg_res_option_1">Original 2x</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(1)" name="jfg_res_option" data-checked="res_option" value="2" id="jfg_res_option_2" style="nav-up: #jfg_wm_option_1; nav-down: #jfg_ds_option_4;"/>
                            <label class="config-option__tab-label" for="jfg_res_option_2">Auto</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(2)">
                        <label class="config-option__title">Downsampling</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(2)" name="jfg_ds_option" data-checked="ds_option" value="1" id="jfg_ds_option_1" style="nav-up: #jfg_res_option_0; nav-down: #jfg_msaa_option_0;"/>
                            <label class="config-option__tab-label" for="jfg_ds_option_1">Off</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(2)" name="jfg_ds_option" data-checked="ds_option" value="2" id="jfg_ds_option_2" style="nav-up: #jfg_res_option_1; nav-down: #jfg_msaa_option_1;"/>
                            <label class="config-option__tab-label" for="jfg_ds_option_2">2x</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(2)" name="jfg_ds_option" data-checked="ds_option" value="4" id="jfg_ds_option_4" style="nav-up: #jfg_res_option_2; nav-down: #jfg_msaa_option_2;"/>
                            <label class="config-option__tab-label" for="jfg_ds_option_4">4x</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(3)">
                        <label class="config-option__title">Anti-Aliasing (MSAA)</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(3)" name="jfg_msaa_option" data-checked="msaa_option" value="0" id="jfg_msaa_option_0" style="nav-up: #jfg_ds_option_1; nav-down: #jfg_smooth_motion_0;"/>
                            <label class="config-option__tab-label" for="jfg_msaa_option_0">None</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(3)" name="jfg_msaa_option" data-checked="msaa_option" value="1" id="jfg_msaa_option_1" style="nav-up: #jfg_ds_option_2; nav-down: #jfg_smooth_motion_60;"/>
                            <label class="config-option__tab-label" for="jfg_msaa_option_1">2x</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(3)" name="jfg_msaa_option" data-checked="msaa_option" value="2" id="jfg_msaa_option_2" style="nav-up: #jfg_ds_option_4; nav-down: #jfg_smooth_motion_90;"/>
                            <label class="config-option__tab-label" for="jfg_msaa_option_2">4x</label>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Frame Rate</label></div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(4)">
                        <label class="config-option__title">Display Frame Rate</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_smooth_motion" data-checked="smooth_motion" value="0" id="jfg_smooth_motion_0" style="nav-up: #jfg_msaa_option_0; nav-down: #jfg_smooth_shadows_on;"/>
                            <label class="config-option__tab-label" for="jfg_smooth_motion_0">Off</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_smooth_motion" data-checked="smooth_motion" value="60" id="jfg_smooth_motion_60" style="nav-up: #jfg_msaa_option_1; nav-down: #jfg_smooth_shadows_off;"/>
                            <label class="config-option__tab-label" for="jfg_smooth_motion_60">60</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_smooth_motion" data-checked="smooth_motion" value="90" id="jfg_smooth_motion_90" style="nav-up: #jfg_msaa_option_2; nav-down: #jfg_smooth_shadows_off;"/>
                            <label class="config-option__tab-label" for="jfg_smooth_motion_90">90</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_smooth_motion" data-checked="smooth_motion" value="120" id="jfg_smooth_motion_120" style="nav-up: #jfg_msaa_option_2; nav-down: #jfg_smooth_shadows_off;"/>
                            <label class="config-option__tab-label" for="jfg_smooth_motion_120">120</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_smooth_motion" data-checked="smooth_motion" value="144" id="jfg_smooth_motion_144" style="nav-up: #jfg_msaa_option_2; nav-down: #jfg_smooth_shadows_off;"/>
                            <label class="config-option__tab-label" for="jfg_smooth_motion_144">144</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_smooth_motion" data-checked="smooth_motion" value="240" id="jfg_smooth_motion_240" style="nav-up: #jfg_msaa_option_2; nav-down: #jfg_smooth_shadows_off;"/>
                            <label class="config-option__tab-label" for="jfg_smooth_motion_240">240</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(4)" name="jfg_smooth_motion" data-checked="smooth_motion" value="1" id="jfg_smooth_motion_1" style="nav-up: #jfg_msaa_option_2; nav-down: #jfg_smooth_shadows_off;"/>
                            <label class="config-option__tab-label" for="jfg_smooth_motion_1">Monitor</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(5)">
                        <label class="config-option__title">Smooth Shadows</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(5)" name="jfg_smooth_shadows" data-checked="smooth_shadows" value="1" id="jfg_smooth_shadows_on" style="nav-up: #jfg_smooth_motion_0; nav-down: #jfg_widescreen_on;"/>
                            <label class="config-option__tab-label" for="jfg_smooth_shadows_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(5)" name="jfg_smooth_shadows" data-checked="smooth_shadows" value="0" id="jfg_smooth_shadows_off" style="nav-up: #jfg_smooth_motion_60; nav-down: #jfg_widescreen_off;"/>
                            <label class="config-option__tab-label" for="jfg_smooth_shadows_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Picture</label></div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(6)">
                        <label class="config-option__title">Widescreen</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(6)" name="jfg_widescreen" data-checked="widescreen" value="1" id="jfg_widescreen_on" style="nav-up: #jfg_smooth_shadows_on; " data-style-nav-down="widescreen == 0 ? '#jfg_fov_input' : '#jfg_hud_corners_on'"/>
                            <label class="config-option__tab-label" for="jfg_widescreen_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(6)" name="jfg_widescreen" data-checked="widescreen" value="0" id="jfg_widescreen_off" style="nav-up: #jfg_smooth_shadows_off; " data-style-nav-down="widescreen == 0 ? '#jfg_fov_input' : '#jfg_hud_corners_off'"/>
                            <label class="config-option__tab-label" for="jfg_widescreen_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(7)" data-style-opacity="widescreen == 0 ? '0.4' : '1'">
                        <label class="config-option__title">HUD in Screen Corners</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(7)" name="jfg_hud_corners" data-checked="hud_corners" value="1" id="jfg_hud_corners_on" style="nav-up: #jfg_widescreen_on; nav-down: #jfg_fov_input;" data-attrif-disabled="widescreen == 0"/>
                            <label class="config-option__tab-label" for="jfg_hud_corners_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(7)" name="jfg_hud_corners" data-checked="hud_corners" value="0" id="jfg_hud_corners_off" style="nav-up: #jfg_widescreen_off; nav-down: #jfg_fov_input;" data-attrif-disabled="widescreen == 0"/>
                            <label class="config-option__tab-label" for="jfg_hud_corners_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(8)">
                        <label class="config-option__title">Field of View</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{fov}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(8)" id="jfg_fov_input" type="range" min="75" max="140" style="flex: 1; margin: 0dp; nav-down: #jfg_texture_filter_0;" data-style-nav-up="widescreen == 0 ? '#jfg_widescreen_on' : '#jfg_hud_corners_on'" data-value="fov"/>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(9)">
                        <label class="config-option__title">Texture Filtering</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(9)" name="jfg_texture_filter" data-checked="texture_filter" value="0" id="jfg_texture_filter_0" style="nav-up: #jfg_fov_input; nav-down: #jfg_output_filter_0;"/>
                            <label class="config-option__tab-label" for="jfg_texture_filter_0">N64 Three-Point</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(9)" name="jfg_texture_filter" data-checked="texture_filter" value="1" id="jfg_texture_filter_1" style="nav-up: #jfg_fov_input; nav-down: #jfg_output_filter_1;"/>
                            <label class="config-option__tab-label" for="jfg_texture_filter_1">Bilinear</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(10)">
                        <label class="config-option__title">Picture Scaling</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(10)" name="jfg_output_filter" data-checked="output_filter" value="0" id="jfg_output_filter_0" style="nav-up: #jfg_texture_filter_0; nav-down: #jfg_hit_flash_input;"/>
                            <label class="config-option__tab-label" for="jfg_output_filter_0">Anti-Aliased</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(10)" name="jfg_output_filter" data-checked="output_filter" value="1" id="jfg_output_filter_1" style="nav-up: #jfg_texture_filter_1; nav-down: #jfg_hit_flash_input;"/>
                            <label class="config-option__tab-label" for="jfg_output_filter_1">Linear</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(10)" name="jfg_output_filter" data-checked="output_filter" value="2" id="jfg_output_filter_2" style="nav-up: #jfg_texture_filter_1; nav-down: #jfg_hit_flash_input;"/>
                            <label class="config-option__tab-label" for="jfg_output_filter_2">Nearest</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(11)">
                        <label class="config-option__title">Hit Flash Opacity</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{hit_flash}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(11)" id="jfg_hit_flash_input" type="range" min="0" max="100" style="flex: 1; margin: 0dp; nav-up: #jfg_output_filter_0; nav-down: #jfg_shadow_opacity_input;" data-value="hit_flash"/>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(12)">
                        <label class="config-option__title">Shadow Opacity</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{shadow_opacity}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(12)" id="jfg_shadow_opacity_input" type="range" min="0" max="200" style="flex: 1; margin: 0dp; nav-up: #jfg_hit_flash_input; nav-down: #jfg_no_lod_on;" data-value="shadow_opacity"/>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Objects</label></div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(13)">
                        <label class="config-option__title">Disable LOD</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(13)" name="jfg_no_lod" data-checked="no_lod" value="1" id="jfg_no_lod_on" style="nav-up: #jfg_shadow_opacity_input; nav-down: #jfg_far_objects_on;"/>
                            <label class="config-option__tab-label" for="jfg_no_lod_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(13)" name="jfg_no_lod" data-checked="no_lod" value="0" id="jfg_no_lod_off" style="nav-up: #jfg_shadow_opacity_input; nav-down: #jfg_far_objects_off;"/>
                            <label class="config-option__tab-label" for="jfg_no_lod_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(14)">
                        <label class="config-option__title">Draw Distant Objects</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(14)" name="jfg_far_objects" data-checked="far_objects" value="1" id="jfg_far_objects_on" style="nav-up: #jfg_no_lod_on; nav-down: #jfg_ssao_on;"/>
                            <label class="config-option__tab-label" for="jfg_far_objects_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(14)" name="jfg_far_objects" data-checked="far_objects" value="0" id="jfg_far_objects_off" style="nav-up: #jfg_no_lod_off; nav-down: #jfg_ssao_off;"/>
                            <label class="config-option__tab-label" for="jfg_far_objects_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Ambient Occlusion</label></div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(15)">
                        <label class="config-option__title">Ambient Occlusion (SSAO)</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(15)" name="jfg_ssao" data-checked="ssao" value="1" id="jfg_ssao_on" style="nav-up: #jfg_far_objects_on; nav-down: #jfg_ssao_strength_input;"/>
                            <label class="config-option__tab-label" for="jfg_ssao_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(15)" name="jfg_ssao" data-checked="ssao" value="0" id="jfg_ssao_off" style="nav-up: #jfg_far_objects_off; nav-down: #jfg_ssao_strength_input;"/>
                            <label class="config-option__tab-label" for="jfg_ssao_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(16)">
                        <label class="config-option__title">SSAO Strength</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{ssao_strength}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(16)" id="jfg_ssao_strength_input" type="range" min="10" max="300" style="flex: 1; margin: 0dp; nav-up: #jfg_ssao_on; nav-down: #jfg_ssao_radius_input;" data-value="ssao_strength"/>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(17)">
                        <label class="config-option__title">SSAO Radius</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{ssao_radius}}</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(17)" id="jfg_ssao_radius_input" type="range" min="10" max="300" style="flex: 1; margin: 0dp; nav-up: #jfg_ssao_strength_input; nav-down: #jfg_bloom_on;" data-value="ssao_radius"/>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Bloom</label></div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(18)">
                        <label class="config-option__title">Bloom</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(18)" name="jfg_bloom" data-checked="bloom" value="1" id="jfg_bloom_on" style="nav-up: #jfg_ssao_radius_input; nav-down: #jfg_bloom_intensity_input;"/>
                            <label class="config-option__tab-label" for="jfg_bloom_on">On</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(18)" name="jfg_bloom" data-checked="bloom" value="0" id="jfg_bloom_off" style="nav-up: #jfg_ssao_radius_input; nav-down: #jfg_bloom_intensity_input;"/>
                            <label class="config-option__tab-label" for="jfg_bloom_off">Off</label>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(19)">
                        <label class="config-option__title">Bloom Intensity</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{bloom_intensity}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(19)" id="jfg_bloom_intensity_input" type="range" min="0" max="300" style="flex: 1; margin: 0dp; nav-up: #jfg_bloom_on; nav-down: #jfg_bloom_threshold_input;" data-value="bloom_intensity"/>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(20)">
                        <label class="config-option__title">Bloom Threshold</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{bloom_threshold}}%</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(20)" id="jfg_bloom_threshold_input" type="range" min="0" max="100" style="flex: 1; margin: 0dp; nav-up: #jfg_bloom_intensity_input; nav-down: #jfg_bloom_radius_input;" data-value="bloom_threshold"/>
                        </div>
                    </div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(21)">
                        <label class="config-option__title">Bloom Radius</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{bloom_radius}}</label>
                            <input class="nav-vert" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(21)" id="jfg_bloom_radius_input" type="range" min="1" max="20" style="flex: 1; margin: 0dp; nav-up: #jfg_bloom_threshold_input; nav-down: #jfg_vignette_on;" data-value="bloom_radius"/>
                        </div>
                    </div>
                    <div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Vignette</label></div>
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(22)">
                        <label class="config-option__title">Vignette</label>
                        <div class="config-option__list">
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(22)" name="jfg_vignette" data-checked="vignette" value="1" id="jfg_vignette_on" style="nav-up: #jfg_bloom_radius_input; nav-down: #jfg_vignette_strength_input;"/>
