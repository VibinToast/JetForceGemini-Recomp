                            <label class="config-option__tab-label" for="jfg_frame_rate_0">30 (Original)</label>
                            <input type="radio" data-event-blur="set_cur_config_index(-1)" data-event-focus="set_cur_config_index(28)" name="jfg_frame_rate" data-checked="frame_rate" value="1" id="jfg_frame_rate_1" style="nav-up: #jfg_show_advanced_off; nav-down: #jfg_fly_speed_input;"/>
                            <label class="config-option__tab-label" for="jfg_frame_rate_1">60 (Experimental)</label>
                        </div>
                    </div>
                    </div>
                    <div data-if="!advanced_hidden"><div class="config-option" style="margin: 24dp 0dp 0dp;"><label class="config-option__title config-group__title">Fly Camera (F7)</label></div></div>
                    <div data-if="!advanced_hidden">
                    <div class="config-option jfg-option" data-event-mouseover="set_cur_config_index(29)">
                        <label class="config-option__title">Fly Speed</label>
                        <div class="config-option__range-wrapper config-option__list">
